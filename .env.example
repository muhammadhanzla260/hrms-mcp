# Copy to .env (gitignored) and fill in. Never commit real values.
HRMS_BASE_URL=https://ppl.falkenherz.net/api/v1
HRMS_EMAIL=muhammad.hanzla@fams.com
HRMS_PASSWORD=

# Login path (unknown yet). Alternatively set HRMS_TOKEN with the Bearer token (expires ~7 days).
HRMS_TOKEN=
HRMS_LOGIN_PATH=

# Value of end_location_id in the punch-out payload (your office/remote location).
HRMS_LOCATION_ID=8
# Seconds offset from UTC sent as gmt_offset (+18000 = UTC+5 Pakistan).
HRMS_GMT_OFFSET=+18000
# Optional: dotted path to the token in the login response, default data.token
HRMS_TOKEN_FIELD=data.token
